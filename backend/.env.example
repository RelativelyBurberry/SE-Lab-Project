# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/alphaforge

# News Provider Configuration (Optional)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Market data fallbacks (optional; Yahoo Finance remains the first provider)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
FMP_API_KEY=your_fmp_api_key_here

# Application Configuration
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Authentication: generate a unique random value of at least 32 characters
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
